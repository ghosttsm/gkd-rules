// GKD 订阅文件 —— 自制规则，多设备共用
// 语法：JSON5（支持注释、单引号、尾逗号）
// 改完规则后，必须把下面的 version 加 1，否则设备不会更新
//
// ===== 处理策略（2026-11-04 用户定的六条）=====
// 1. 银行类应用一律不管：见每条规则的 apps 排除块（enable:false），共 20 个银行包名
// 2. 所有提示更新的弹窗：一律选"不更新"
// 3. 所有营销/领奖弹窗：一律不领取，只关闭
// 4. 所有要定位的弹窗：一律不允许
// 5. 所有要通知权限的弹窗：一律不允许
// 6. 所有要访问剪切板的弹窗：一律不允许
//
// 注意：银行排除必须写在**每条规则**的 apps 上。
// 写在规则组级别（group.apps）GKD 不识别，实测银行应用仍会计入全部全局组。
{
  id: 860412,          // 订阅唯一标识，GKD 靠它认人。定了就不要改，改了会变成另一个订阅
  name: 'ghost 自制规则',
  version: 10,
  author: 'ghosttsm',

  // 设备定时请求这个地址检测更新。
  // 手机在国内直连 raw.githubusercontent.com 会超时，必须走镜像。
  // 2026-11-04 18:10 实测：gh-proxy.com 已完全不通；ghfast.top 可用且为最新版；
  // jsdelivr 缓存滞后严重（返回 v1），不可用。镜像会失效，换之前先实测三个再改这里。
  updateUrl: 'https://ghfast.top/https://raw.githubusercontent.com/ghosttsm/gkd-rules/main/gkd.json5',
  checkUpdateUrl: 'https://ghfast.top/https://raw.githubusercontent.com/ghosttsm/gkd-rules/main/gkd.json5',

  // 全局规则：不分应用，靠选择器通杀。适合开屏广告、更新弹窗这类各家长得都一样的场景
  globalGroups: [
    {
      key: 0,
      name: '开屏广告',
      // 应用启动后只在这个时间窗内匹配，避免误伤应用内正常内容
      matchTime: 10000,
      // 每个应用只执行 1 次
      actionMaximum: 1,
      // 启动新应用时重置上面的计数
      resetMatch: 'app',
      rules: [
        // 跳过按钮的文字特征：含跳过、字数很短、当前可见
        { key: 0, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text*="跳过"][text.length<10][visibleToUser=true]' },
        // 部分应用写成"跳过广告"
        { key: 1, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text*="跳过广告"][visibleToUser=true]' },
      ],
    },

    {
      key: 1,
      name: '更新弹窗-不更新',
      // 策略 2：凡提示升级/更新的弹窗，一律选拒绝项，绝不点"立即升级"
      // 不设 matchTime：更新弹窗既可能在启动时弹，也可能使用中弹
      actionMaximum: 2,
      actionCd: 1500,
      resetMatch: 'app',
      rules: [
        // 主力：暂不升级/暂不更新/暂不使用/暂不开启 等全部拒绝语义
        { key: 0, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text*="暂不"][text.length<8][clickable=true][visibleToUser=true]' },
        { key: 1, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="忽略此版本"][clickable=true][visibleToUser=true]' },
        { key: 2, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="跳过此版本"][clickable=true][visibleToUser=true]' },
        { key: 3, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="以后更新"][clickable=true][visibleToUser=true]' },
        { key: 4, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="以后再说"][clickable=true][visibleToUser=true]' },
        { key: 5, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="稍后再说"][clickable=true][visibleToUser=true]' },
        { key: 6, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="下次再说"][clickable=true][visibleToUser=true]' },
        { key: 7, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="稍后提醒"][clickable=true][visibleToUser=true]' },
        { key: 8, apps: [{ id: 'cmb.pb', enable: false }, { id: 'com.alipay.antbank.hk.portal', enable: false }, { id: 'com.android.bankabc', enable: false }, { id: 'com.bankcomm.Bankcomm', enable: false }, { id: 'com.bochk.app.aos', enable: false }, { id: 'com.cebbank.mobile.cemb', enable: false }, { id: 'com.chinamworld.bocmbci', enable: false }, { id: 'com.chinamworld.main', enable: false }, { id: 'com.ecitic.bank.mobile', enable: false }, { id: 'com.hnnx.mmbank', enable: false }, { id: 'com.hnnx.pmbank', enable: false }, { id: 'com.hxb.mobile.client', enable: false }, { id: 'com.icbc', enable: false }, { id: 'com.pingan.paces.ccms', enable: false }, { id: 'com.unionpay', enable: false }, { id: 'com.unionpay.tsmservice', enable: false }, { id: 'com.yitong.mbank.psbc', enable: false }, { id: 'com.zhongan.ibank', enable: false }, { id: 'com.zzbank.pibp', enable: false }, { id: 'hk.com.hsbc.hsbchkmobilebanking', enable: false }], matches: '[text="不更新"][clickable=true][visibleToUser=true]' },
      ],
    },

    {
      key: 2,
      name: '权限引导-一律拒绝',
      // 策略 4/5/6：所有索要 定位、通知、剪切板 的引导弹窗，一律点拒绝。
