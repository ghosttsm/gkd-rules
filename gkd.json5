  // 应用规则：按包名精确指定，比全局规则更安全
  apps: [
    {
      id: 'gov.pianzong.androidnga',
      name: 'NGA玩家社区',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          actionMaximum: 1,
          matchTime: 15000,
          resetMatch: 'app',
          rules: [
            // 精确匹配：首选。2026-11 NGA 版本的开屏跳过按钮
            { key: 0, matches: '[vid="tv_skip"]' },
            // 文本兜底：App 改版换了 id 仍能命中
            { key: 1, matches: '[text*="跳过"][text.length<10][clickable=true]' },
          ],
        },
      ],
    },

    {
      id: 'com.taobao.taobao',
      name: '淘宝',
      groups: [
        {
          key: 0,
          name: '营销弹窗',
          // 2026-11-04 实测抓到的特征：那个灰色圆形 × 是 91x91 的 FrameLayout，
          // 没有 vid、没有可读 desc，内部唯一的文字是图标字体字符 "뉜"。
          // 这是目前唯一能稳定定位它的方式。
          actionMaximum: 3,
          actionCd: 2000,
          resetMatch: 'app',
          rules: [
            // 关键：这个字符所在的 TextView 自身不可点击，可点击的是外面 91x91 的父容器，
            // 所以这里绝不能加 clickable=true，加了就永远匹配不到。
            // GKD 命中后会自动点击最近的可点击祖先节点。
            { key: 0, matches: '[text="뉜"][visibleToUser=true]' },
          ],
        },
      ],
    },

    // 新应用模板：复制这段，取消注释，填包名和选择器
