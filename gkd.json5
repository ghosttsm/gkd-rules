// GKD 订阅文件 —— 自制规则，多设备共用
// 语法：JSON5（支持注释、单引号、尾逗号）
// 改完规则后，必须把下面的 version 加 1，否则设备不会更新
{
  id: 860412,          // 订阅唯一标识，GKD 靠它认人。定了就不要改，改了会变成另一个订阅
  name: 'ghost 自制规则',
  version: 4,
  author: 'ghosttsm',

  // 设备定时请求这个地址检测更新。
  // 手机在国内直连 raw.githubusercontent.com 会超时（实测 15s 无响应），必须走镜像。
  // gh-proxy.com 实测无缓存、推完立刻可见；ghfast.top 有缓存会滞后，别用。
  updateUrl: 'https://gh-proxy.com/https://raw.githubusercontent.com/ghosttsm/gkd-rules/main/gkd.json5',
  checkUpdateUrl: 'https://gh-proxy.com/https://raw.githubusercontent.com/ghosttsm/gkd-rules/main/gkd.json5',

  // 全局规则：不分应用，靠选择器通杀。适合开屏广告这种各家长得都一样的场景
  globalGroups: [
    {
      key: 0,
      name: '开屏广告',
      // 应用启动后只在这个时间窗内匹配，避免误伤应用内正常内容
      matchTime: 10000,
      // 每个应用只执行 1 次
      actionMaximum: 1,
      // 启动新应用时重置上面的计数
      resetMatch: 'app',
      rules: [
        // 跳过按钮的文字特征：含"跳过"、字数很短、当前可见
        { key: 0, matches: '[text*="跳过"][text.length<10][visibleToUser=true]' },
        // 部分应用写成"跳过广告"
        { key: 1, matches: '[text*="跳过广告"][visibleToUser=true]' },
      ],
    },
  ],

  // 应用规则：按包名精确指定，比全局规则更安全
  apps: [
    {
      id: 'gov.pianzong.androidnga',
      name: 'NGA玩家社区',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          actionMaximum: 1,
          matchTime: 15000,
          resetMatch: 'app',
          rules: [
            // 精确匹配：首选。2026-11 NGA 版本的开屏跳过按钮
            { key: 0, matches: '[vid="tv_skip"]' },
            // 文本兜底：App 改版换了 id 仍能命中
            { key: 1, matches: '[text*="跳过"][text.length<10][clickable=true]' },
          ],
        },
      ],
    },

    {
      id: 'com.zhihu.android',
      name: '知乎',
      groups: [
        {
          key: 0,
          name: '位置权限引导',
          // 这是权限引导弹窗，不是广告。出现时机不固定在启动瞬间，
          // 所以不设 matchTime，改用 actionMaximum 限制每次进入应用最多点一次
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            // 主选择器：2026-11 版本实测，按钮的 resource-id 短名固定
            // 弹窗文案：「获得更好的使用体验 / 请允许使用位置信息…」
            { key: 0, matches: '[vid="location_permission_not_now"]' },
            // 兜底：改版换了 id 时按文字点，作用是拒绝授权而不是给权限
            { key: 1, matches: '[text="暂不开启"][clickable=true][visibleToUser=true]' },
          ],
        },
      ],
    },

    // 新应用模板：复制这段，取消注释，填包名和选择器
    // {
    //   id: 'com.example.app',        // 包名，pm list packages 或 GKD 应用详情能看到
    //   name: '某应用',
    //   groups: [
    //     {
    //       key: 0,
    //       name: '开屏广告',
    //       activityIds: 'com.example.app.SplashActivity',  // 可省略；写上能避免误触
    //       rules: [
    //         { key: 0, matches: '[vid="skip_btn"]', actionMaximum: 1, resetMatch: 'app' },
    //       ],
    //     },
    //   ],
    // },
  ],

  // ===== 待办：淘宝营销弹窗（2026-11-04 抓到特征，暂未启用）=====
  // 现象1：冷启动时弹「双11品类周 · 5元红包」大卡片（居中，下方灰色圆形 ×）
  // 现象2：首页底部常驻横幅「您有5元无门槛惊喜红包 [去使用] [×]」
  // 特征：关闭叉是 91x91 的容器，位置 (1122,2312)，容器内文字是图标字体字符 "뉜"，
  //       没有 vid，也没有可读的 desc，只能靠这个字符定位
  // 启用方式：取消下面整段的注释，并移进上面的 apps 数组
  //
  // {
  //   id: 'com.taobao.taobao',
  //   name: '淘宝',
  //   groups: [
  //     {
  //       key: 0,
  //       name: '营销弹窗',
  //       actionMaximum: 1,
  //       resetMatch: 'app',
  //       rules: [
  //         { key: 0, matches: '[text="뉜"][clickable=true]' },
  //       ],
  //     },
  //   ],
  // },
}
